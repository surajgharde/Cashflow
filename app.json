{
  "expo": {
    "name": "Cashflow Guardian",
    "slug": "cashflow-guardian",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "cashflowguardian",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#111317",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "io.innovexc.cashflowguardian"
    },
    "android": {
      "package": "io.innovexc.cashflowguardian",
      "adaptiveIcon": {
        "backgroundColor": "#111317"
      }
    },
    "web": {
      "bundler": "metro",
      "output": "single"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-status-bar",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#111317"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": false
    }
  }
}
